{
  "version": 1,
  "note": "任务集来自这台设备上的真实使用：设备查询、源码定位与改动、APK 初筛、抓包环境、Skill 执行、UI 观察。held_out 为留出子集，只用于防止对任务集过拟合。",
  "tasks": [
    {
      "id": "device-status",
      "category": "device",
      "prompt": "看一下手机现在的电量、内存和存储占用，再说说还能不能装下一个 8GB 的游戏。",
      "tools": ["device_status", "top_storage_apps", "get_current_context", "get_health_summary"],
      "expect_first_tool": ["device_status", "top_storage_apps"],
      "expect_arguments": {},
      "tool_result": {"ok": true, "battery": 82, "storage_free_gb": 41}
    },
    {
      "id": "current-time-place",
      "category": "device",
      "prompt": "现在几点？我大概在哪个位置？",
      "tools": ["get_current_context", "get_current_location", "device_status"],
      "expect_first_tool": ["get_current_context"],
      "expect_arguments": {},
      "tool_result": {"ok": true, "time": "2026-09-17T03:20:00+08:00", "timezone": "Asia/Shanghai"}
    },
    {
      "id": "locate-concurrency-constant",
      "category": "code",
      "prompt": "在 Eta 源码里找出 AgentLoop 的并发上限常量定义，把定义那一行和它前后的实现一起给我。",
      "tools": ["search_code", "read_file", "list_directory", "run_stats"],
      "expect_first_tool": ["search_code"],
      "expect_arguments": {"pattern": "MAX_PARALLEL_TOOL_CALLS", "path": "/workspace/Eta-src"},
      "tool_result": {"ok": true, "matches": 3}
    },
    {
      "id": "edit-config-default",
      "category": "code",
      "prompt": "把 Prefs.kt 里 agent_parallel_tool_limit 的默认值从 4 改成 8，改完告诉我改动了哪一行。",
      "tools": ["edit_file", "read_file", "search_code"],
      "expect_first_tool": ["read_file", "search_code", "edit_file"],
      "expect_arguments": {"path": "/workspace/Eta-src/app/src/main/kotlin/io/github/asagnc/eta/config/Prefs.kt"},
      "tool_result": {"ok": true, "bytes_written": 8271}
    },
    {
      "id": "apk-static-scan",
      "category": "security",
      "prompt": "对 /workspace/test-base.apk 做一次静态初筛：包名、权限、有没有 native 库和 dex 数量。",
      "tools": ["terminal", "read_file", "list_directory", "search_code"],
      "expect_first_tool": ["terminal"],
      "expect_arguments": {"action": "open_and_exec", "command": "cd /workspace && unzip -l test-base.apk | head -40", "environment": "linux"},
      "tool_result": {"ok": true, "output": "清单已输出"}
    },
    {
      "id": "capture-env-status",
      "category": "security",
      "prompt": "先确认一下当前的抓包环境是什么状态，再决定要不要重建 CA 注入。",
      "tools": ["terminal", "read_file"],
      "expect_first_tool": ["terminal"],
      "expect_arguments": {"action": "open_and_exec", "command": "bash /data/local/tmp/eta/capture-status.sh", "environment": "android"},
      "tool_result": {"ok": true, "output": "capture disabled"},
      "held_out": true
    },
    {
      "id": "skill-declared-command",
      "category": "skill",
      "prompt": "用已安装 Skill 里声明好的命令把抓包环境搭起来，不要把整篇 SKILL.md 读进来。",
      "tools": ["skills_list", "skills_read", "skills_run", "terminal"],
      "expect_first_tool": ["skills_run", "skills_list"],
      "expect_arguments": {"skillId": "capture-traffic"},
      "tool_result": {"ok": true, "output": "capture ready"}
    },
    {
      "id": "observe-clickable-nodes",
      "category": "ui",
      "prompt": "现在屏幕上都有哪些可以点的按钮？列出来就行。",
      "tools": ["observe_screen", "tap_element", "read_image", "wait_for_text"],
      "expect_first_tool": ["observe_screen"],
      "expect_arguments": {},
      "tool_result": {"ok": true, "nodes": 12}
    },
    {
      "id": "open-wechat",
      "category": "ui",
      "prompt": "帮我打开微信。",
      "tools": ["search_apps", "launch_app", "open_uri"],
      "expect_first_tool": ["launch_app", "search_apps"],
      "expect_arguments": {"package_name": "com.tencent.mm"},
      "tool_result": {"ok": true, "package_name": "com.tencent.mm"}
    },
    {
      "id": "plan-and-track",
      "category": "agent",
      "prompt": "帮我排一下顺序并跟踪进度：先查设备状态，再改一处配置，最后跑一遍单测。",
      "tools": ["task_plan", "device_status", "edit_file", "terminal"],
      "expect_first_tool": ["task_plan"],
      "expect_arguments": {
        "todos": [
          {"id": "1", "content": "查设备状态", "status": "in_progress"},
          {"id": "2", "content": "改一处配置", "status": "pending"},
          {"id": "3", "content": "跑一遍单测", "status": "pending"}
        ]
      },
      "tool_result": {"ok": true}
    },
    {
      "id": "recall-build-command",
      "category": "memory",
      "prompt": "我之前把 Eta 的构建命令记在哪了？",
      "tools": ["memory_get", "search_code", "read_file"],
      "expect_first_tool": ["memory_get"],
      "expect_arguments": {"query": "构建"},
      "tool_result": {"ok": true, "content": "gradlew :app:assembleDebug"}
    },
    {
      "id": "self-run-stats",
      "category": "meta",
      "prompt": "看一下这次 run 到现在调了多少次工具，哪一类最多。",
      "tools": ["run_stats", "search_code", "list_directory"],
      "expect_first_tool": ["run_stats"],
      "expect_arguments": {},
      "tool_result": {"ok": true, "tool_calls": 23},
      "held_out": true
    },
    {
      "id": "logcat-model-failure",
      "category": "device",
      "prompt": "查一下最近的系统日志，有没有模型请求失败的痕迹。",
      "tools": ["get_logcat", "terminal", "read_file"],
      "expect_first_tool": ["get_logcat"],
      "expect_arguments": {"query": "Agent runtime failed"},
      "tool_result": {"ok": true, "lines": 4},
      "held_out": true
    }
  ]
}
